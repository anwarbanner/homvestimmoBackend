<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!--
            Never let real social-media credentials leak into a test run:
            the container's env_file already carries real Facebook/Instagram
            tokens, and a test that forgets to Queue::fake()/Http::fake()
            once caused a real post on the production Facebook Page. See
            tests/TestCase.php's Http::preventStrayRequests() for the other
            half of this guard.
        -->
        <env name="FACEBOOK_PAGE_ID" value="test-page-id" force="true"/>
        <env name="FACEBOOK_PAGE_TOKEN" value="test-page-token" force="true"/>
        <env name="INSTAGRAM_BUSINESS_ACCOUNT_ID" value="test-ig-account-id" force="true"/>
        <env name="INSTAGRAM_ACCESS_TOKEN" value="test-ig-token" force="true"/>
    </php>
</phpunit>
